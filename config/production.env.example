# =============================================================================
# ENTERPRISE AI AGENTS - PRODUCTION CONFIGURATION
# =============================================================================
# This file contains all environment variables required for production deployment.
# Copy to .env and fill in actual values before deployment.
# NEVER commit actual credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# ANTHROPIC API (Required)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_256_BIT_SECRET_KEY
JWT_ISSUER=enterprise-agents
JWT_AUDIENCE=enterprise-agents-api
JWT_EXPIRY=1h

# CORS Configuration
CORS_ORIGINS=https://agents.yourcompany.com,https://admin.yourcompany.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_SECRET
SESSION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# DATA PERSISTENCE
# -----------------------------------------------------------------------------
# Redis (for caching and sessions)
REDIS_URL=redis://redis.internal:6379
REDIS_PASSWORD=your_redis_password
REDIS_TLS=true

# PostgreSQL (for persistent storage)
DATABASE_URL=postgresql://user:password@postgres.internal:5432/enterprise_agents
DATABASE_SSL=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# ENTERPRISE INTEGRATIONS (Configure as needed)
# -----------------------------------------------------------------------------

# ServiceNow ITSM
SERVICENOW_INSTANCE=https://yourcompany.service-now.com
SERVICENOW_USERNAME=integration_user
SERVICENOW_PASSWORD=xxxxxxxx
SERVICENOW_CLIENT_ID=xxxxxxxxxxxxxxxx
SERVICENOW_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# Workday HCM
WORKDAY_TENANT=yourcompany
WORKDAY_HOST=https://wd5-impl-services1.workday.com
WORKDAY_CLIENT_ID=xxxxxxxxxxxxxxxx
WORKDAY_CLIENT_SECRET=xxxxxxxxxxxxxxxx
WORKDAY_REFRESH_TOKEN=xxxxxxxxxxxxxxxx

# Salesforce CRM
SALESFORCE_INSTANCE_URL=https://yourcompany.my.salesforce.com
SALESFORCE_CLIENT_ID=xxxxxxxxxxxxxxxx
SALESFORCE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
SALESFORCE_USERNAME=integration@yourcompany.com
SALESFORCE_PASSWORD=xxxxxxxx
SALESFORCE_SECURITY_TOKEN=xxxxxxxx

# Azure Active Directory / Microsoft Entra ID
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxx

# SAP S/4HANA
SAP_HOST=https://sap.yourcompany.com:443
SAP_CLIENT=100
SAP_USERNAME=RFC_USER
SAP_PASSWORD=xxxxxxxx

# Atlassian Jira
JIRA_HOST=https://yourcompany.atlassian.net
JIRA_EMAIL=integration@yourcompany.com
JIRA_API_TOKEN=xxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# Logging
LOG_DESTINATION=console
LOG_FILE_PATH=/var/log/enterprise-agents

# Metrics (Prometheus-compatible)
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Tracing (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4317
OTEL_SERVICE_NAME=enterprise-agents
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Health Checks
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_CIRCUIT_BREAKER=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_SYNTHETIC_DATA=false

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# AGENT CONFIGURATION
# -----------------------------------------------------------------------------
# Default budget limits per agent execution (USD)
AGENT_DEFAULT_MAX_BUDGET=5.00
AGENT_MAX_TURNS=25

# Execution timeouts (milliseconds)
AGENT_EXECUTION_TIMEOUT=300000
INTEGRATION_REQUEST_TIMEOUT=30000

# -----------------------------------------------------------------------------
# CONTENT SECURITY
# -----------------------------------------------------------------------------
# PII Detection
ENABLE_PII_DETECTION=true
PII_REDACTION_MODE=mask

# Content Filtering
ENABLE_CONTENT_FILTERING=true
BLOCKED_TOPICS=

# Output Validation
ENABLE_OUTPUT_VALIDATION=true
MAX_OUTPUT_LENGTH=100000
